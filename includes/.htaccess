# Folder ini isinya helper/config PHP (termasuk kredensial: db.config.php, mail.config.php,
# rajaongkir.config.php) yang cuma pernah dipakai lewat include/require dari file lain,
# tidak pernah diakses langsung lewat URL. Blokir total.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
